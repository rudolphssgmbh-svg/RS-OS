services:
  postgres:
    image: postgres:16
    container_name: rsos-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: rsos
      POSTGRES_PASSWORD: rsos_secure_2026
      POSTGRES_DB: rsos_runtime
    ports:
      - "5432:5432"
    volumes:
      - ./storage/postgres:/var/lib/postgresql/data

  redis:
    image: redis:7
    container_name: rsos-redis
    restart: unless-stopped
    ports:
      - "6379:6379"

  runtime-api:
    build: ./runtime-api
    container_name: rsos-runtime-api
    restart: unless-stopped
    ports:
      - "8080:8080"
